APP_NAME=Question-To-Quiz
APP_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-a-random-database-password
DB_NAME=replace-with-database-name
DB_SSLMODE=disable
# Production: APP_ENV=production; PUBLIC_ORIGIN=https://your-real-domain
# Use HTTPS at the reverse proxy; restrict direct access to the backend/DB.
# For remote production PostgreSQL use DB_SSLMODE=verify-full with trusted CA.

# Development inbox: docker compose --profile dev-mail up -d mailpit
# With backend in Docker use mailpit; with go run on host use localhost.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
SMTP_TLS=none
# Gmail SMTP: host=smtp.gmail.com, port=587, tls=starttls
# SMTP_USER/SMTP_FROM=your sender address; SMTP_PASSWORD=Google App Password.
# Never put your Google account password into SMTP_PASSWORD.
# Production requires SMTP_TLS=starttls or tls and a real sender.

# Google OAuth web client. Leave both credentials blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to PUBLIC_ORIGIN plus /v1/auth/google/callback.
GOOGLE_REDIRECT_URL=
