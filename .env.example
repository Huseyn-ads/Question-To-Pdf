APP_NAME=Question-To-Quiz
APP_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-a-random-database-password
DB_NAME=replace-with-database-name
DB_SSLMODE=disable
# Production: APP_ENV=production; PUBLIC_ORIGIN=https://your-real-domain
# Use HTTPS at the reverse proxy; restrict direct access to the backend/DB.
# For remote production PostgreSQL use DB_SSLMODE=verify-full with trusted CA.
